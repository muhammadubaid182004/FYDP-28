# Backend Configuration

# Server
PORT=8000
NODE_ENV=development

# Database (JSON file)
DB_PATH=./predictions.db

# Authentication
JWT_SECRET=your-random-secret-key-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:3000
MODEL_ONNX_PATH=best.onnx
MODEL_ENGINE_PATH=best.engine
TENSORRT_RUNNER_PATH=tensorrt_inference.py
MODEL_INPUT_SIZE=256
MODEL_CLASS_LABELS=Nrdr,Rdr
MODEL_NORMALIZATION=none
MODEL_OUTPUT_KIND=auto
MODEL_CONFIDENCE_THRESHOLD=0.5
ALLOW_ONNX_FALLBACK=true

# Keep these local inference settings for same-device model execution.
