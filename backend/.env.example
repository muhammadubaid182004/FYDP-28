# Backend Configuration

# Server
PORT=8000
NODE_ENV=development

# Database (JSON file)
DB_PATH=./predictions.db

# Authentication
JWT_SECRET=your-random-secret-key-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:3000

# ========================================
# JETSON ORIN NANO CONFIGURATION
# ========================================

# Option 1: Use Jetson IP (for local network deployment)
JETSON_IP_ADDRESS=192.168.1.100

# Option 2: Use localhost (for testing locally)
# JETSON_IP_ADDRESS=localhost

# Jetson will run TensorRT inference at:
# http://{JETSON_IP_ADDRESS}:8000/api/predict
