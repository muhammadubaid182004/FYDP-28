# Backend Configuration

# Server
PORT=8000
NODE_ENV=development

# Database
# Local database is the primary write target (app reads/writes here first)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Keep DATABASE_URL for backward compatibility; set it same as LOCAL_DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_SSL=false
# Deployed/remote database for periodic synchronization
DEPLOYED_DATABASE_URL=
DEPLOYED_DATABASE_SSL=require
# Sync local -> deployed by serial_number
DB_SYNC_INTERVAL_MS=60000
DB_SYNC_BATCH_SIZE=100

# Authentication
JWT_SECRET=your-random-secret-key-change-this-in-production

# CORS
FRONTEND_URL=http://localhost:3000
MODEL_ONNX_PATH=best.onnx
MODEL_ENGINE_PATH=best.engine
TENSORRT_RUNNER_PATH=tensorrt_inference.py
MODEL_INPUT_SIZE=256
MODEL_CLASS_LABELS=Nrdr,Rdr
MODEL_NORMALIZATION=none
MODEL_OUTPUT_KIND=auto
MODEL_CONFIDENCE_THRESHOLD=0.5
ALLOW_ONNX_FALLBACK=true

# Keep these local inference settings for same-device model execution.

# S3 Storage
# Primary uploads: LOCAL_S3_URI overrides S3_URI when both are set (e.g. MinIO locally)
S3_URI=
LOCAL_S3_URI=
# Remote bucket for sync when offline uploads miss (uses same local disk layout keys)
DEPLOYED_S3_URI=
DEPLOYED_AWS_REGION=
DEPLOYED_AWS_ACCESS_KEY_ID=
DEPLOYED_AWS_SECRET_ACCESS_KEY=
DEPLOYED_AWS_SESSION_TOKEN=
DEPLOYED_S3_ENDPOINT=
DEPLOYED_S3_FORCE_PATH_STYLE=false
# Must match your bucket region (HeadBucket/list/put use this endpoint)
AWS_REGION=eu-north-1
# Static IAM user credentials (picked up automatically by @aws-sdk/client-s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional — only when using temporary creds / SSO session / assumed role output
AWS_SESSION_TOKEN=
# Optional for S3-compatible providers (e.g. MinIO, Cloudflare R2)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# On AWS (EC2/ECS/Lambda), you can omit the keys above and use an IAM role instead.

# Periodic sync: uploads local files under uploads/, images/NRDR/, images/RDR/ to DEPLOYED_S3_URI when set,
# otherwise heals against the configured primary bucket. Set to 0 to disable polling.
S3_SYNC_INTERVAL_MS=60000
S3_SYNC_BATCH_SIZE=50
