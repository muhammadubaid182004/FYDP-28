# Model Configuration
# Copy this file to .env.local and fill in your model URL

# Model serving URL (can be local or CDN)
VITE_MODEL_URL=/models/dr-classification.onnx

# ONNX Runtime execution providers
# Options: webgpu, wasm, cpu
# webgpu: GPU acceleration (fastest, experimental)
# wasm: WebAssembly backend (good browser support)
# cpu: CPU only (slowest)
VITE_EXECUTION_PROVIDERS=webgpu,wasm

# Model metadata
VITE_MODEL_INPUT_SIZE=224
VITE_MODEL_VERSION=1.0.0

# Classification settings
VITE_CONFIDENCE_THRESHOLD=0.7

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENDPOINT=https://api.example.com/analytics

# Deployment
VITE_ENVIRONMENT=production
VITE_API_BASE_URL=https://api.example.com
